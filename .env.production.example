DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key-at-least-50-chars
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=incardbook.com,www.incardbook.com,cardbook-45cf0409dc07.herokuapp.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://incardbook.com,https://www.incardbook.com,https://cardbook-45cf0409dc07.herokuapp.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_CSRF_COOKIE_HTTPONLY=False

CARDBOOK_APP_VERSION=0.14.0
CARDBOOK_DEPLOY_ENV=production
CARDBOOK_RELEASE_COMMIT=local
CARDBOOK_LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=WARNING
CARDBOOK_ENABLE_REQUEST_ID_HEADERS=True
AI_AGENT_PUBLIC_ASK_LIMIT=30
AI_AGENT_PUBLIC_ASK_WINDOW_SECONDS=60
AI_AGENT_PUBLIC_LEAD_LIMIT=5
AI_AGENT_PUBLIC_LEAD_WINDOW_SECONDS=3600
AI_AGENT_MAX_QUESTION_LENGTH=500
AI_AGENT_MAX_LEAD_FIELD_LENGTH=255
AI_AGENT_MAX_LEAD_MESSAGE_LENGTH=1200
CORS_ALLOWED_ORIGINS=https://incardbook.com,https://www.incardbook.com

DATABASE_URL=postgres://user:password@host:5432/dbname

DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=apikey-or-user
EMAIL_HOST_PASSWORD=replace-with-provider-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Cardbook <no-reply@incardbook.com>
SERVER_EMAIL=Cardbook Server <server@incardbook.com>

DJANGO_MEDIA_URL=/media/
DJANGO_USE_S3_MEDIA_STORAGE=True
AWS_ACCESS_KEY_ID=replace-with-access-key
AWS_SECRET_ACCESS_KEY=replace-with-secret-key
AWS_STORAGE_BUCKET_NAME=incardbook-media
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=False
AWS_S3_CACHE_CONTROL=max-age=86400

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DASHBOARD_URL=https://dashboard.stripe.com/
STRIPE_CUSTOMER_PORTAL_RETURN_URL=https://incardbook.com/dashboard/finance/subscriptions/
STRIPE_ALLOW_MANUAL_REFUNDS=False
